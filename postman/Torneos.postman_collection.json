{
  "info": {
    "name": "Torneos de Videojuegos - API REST",
    "description": "Colección para probar la API de ArenaGG. Ejecutá las carpetas en orden (o todo con el Runner). Antes, configurá adminUser y adminPassword en las variables de la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Registrar jugador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Respuesta JSON\", function () { pm.response.to.be.json; });",
                  "const datos = pm.response.json();",
                  "pm.test(\"Devuelve token y usuario\", function () { pm.expect(datos.token).to.be.a(\"string\"); pm.expect(datos.usuario.rol).to.eql(\"jugador\"); });",
                  "pm.collectionVariables.set(\"jugadorToken\", datos.token);",
                  "pm.collectionVariables.set(\"jugadorId\", datos.usuario.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "description": "Crea una cuenta de jugador y guarda su token en {{jugadorToken}}.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"jugador_{{$timestamp}}\",\n  \"email\": \"jugador{{$timestamp}}@mail.com\",\n  \"password\": \"Clave1234\",\n  \"juegos_favoritos\": [\n    \"Valorant\",\n    \"Rocket League\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Registro inválido (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Respuesta JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"Incluye mensaje de error\", function () { pm.expect(pm.response.json()).to.have.property(\"error\"); });",
                  "pm.test(\"Detalla los campos con error\", function () { pm.expect(pm.response.json().detalles).to.have.keys(\"username\", \"email\", \"password\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"x\",\n  \"email\": \"correo-invalido\",\n  \"password\": \"123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Respuesta JSON\", function () { pm.response.to.be.json; });",
                  "const datos = pm.response.json();",
                  "pm.test(\"Es administrador\", function () { pm.expect(datos.usuario.rol).to.eql(\"admin\"); });",
                  "pm.collectionVariables.set(\"adminToken\", datos.token);"
                ]
