# Clave para firmar los tokens JWT. Usá una cadena larga y aleatoria en producción.
SECRET_KEY=arenagg-desarrollo-local-2026-cambiar-en-produccion

# Base SQLite. Se crea automáticamente al iniciar la aplicación.
DATABASE_URL=sqlite:///./arenagg.db

# Minutos de validez de cada token JWT.
TOKEN_EXPIRACION_MINUTOS=120

# Orígenes externos permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
