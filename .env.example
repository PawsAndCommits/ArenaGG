# Clave para firmar los tokens JWT, usa una cadena larga y aleatoria en produccion
SECRET_KEY=arenagg-desarrollo-local-2026-cambiar-en-produccion

# Base SQLite, se crea automaticamente al iniciar la aplicacion
DATABASE_URL=sqlite:///./arenagg.db

# Minutos de validez de cada token JWT
TOKEN_EXPIRACION_MINUTOS=120

# Origenes externos permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
