# Claves de Steam
STEAM_API_KEY=tu_steam_web_api_key_aca

# Servidores de CS2: apagado por defecto. Ponelo en true solo si vas a usar RCON.
MODO_SERVIDORES=false

# Secreto para el webhook del servidor CS2 (solo con MODO_SERVIDORES=true)
CS2_WEBHOOK_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# Opcional: si no se define, se genera una automatica en instance/secret_key.txt
# SECRET_KEY=otra_clave_secreta
